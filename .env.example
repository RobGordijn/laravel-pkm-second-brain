APP_NAME="Second Brain"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL with the pgvector extension is required (vector search and
# full-text search use Postgres-specific column types and indexes).
# The migrations enable the extension; your database user needs the rights to do so.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Notes are processed by queued jobs: keep a worker running (php artisan queue:work).
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

#--------------------------------------------------------------------------
# AI providers (Laravel AI SDK)
#--------------------------------------------------------------------------
# Provider for the agents: analysis, linking, answers, digest, tags, insights.
AI_PROVIDER=gemini

# Provider for embeddings (semantic search and linking). Embeddings are always
# requested with 1536 dimensions to match the vector column. When you switch
# embedding models, re-embed your notes and recalibrate the similarity
# thresholds below.
AI_EMBEDDINGS_PROVIDER=gemini

# Provider for classification (note type, and whether a note is too vague).
# It must support classification in the Laravel AI SDK.
AI_CLASSIFICATION_PROVIDER=gemini

# Only the keys of the providers you use are needed.
# All other supported providers are listed in config/ai.php.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

#--------------------------------------------------------------------------
# Second Brain settings (config/pkm.php)
#--------------------------------------------------------------------------
# Bearer token for POST /api/capture (iOS Shortcut, bookmarklet, scripts).
# The capture API is disabled while this is empty.
PKM_CAPTURE_TOKEN=

# Probability (0-1) from which a new note counts as too vague, after which
# the app asks you one short follow-up question.
PKM_VAGUE_THRESHOLD=0.7

# Seconds to wait after the first change to a note you write yourself before
# the AI pass runs, so a writing session triggers one AI run, not one per autosave.
PKM_WRITE_PROCESSING_DELAY=120

# Minimum cosine similarity (0-1) for a note to be a link candidate; the AI
# then decides which candidates are genuinely related. Calibrated for
# gemini-embedding-2.
PKM_LINK_CANDIDATE_MIN_SIMILARITY=0.6

# Minimum cosine similarity (0-1) for semantic search results.
PKM_SEARCH_MIN_SIMILARITY=0.6

# Number of uses (opened, or cited in an answer) after which a note without
# a key insight invites you to write one.
PKM_DISTILL_AFTER_USES=3

# Days the AI log keeps every call before it is pruned.
PKM_AI_LOG_RETENTION_DAYS=30
